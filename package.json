{
  "name": "zpwc.gts.spl-adjudication",
  "version": "0.0.1",
  "private": true,
  "description": "SPL hit adjudication worklist and case detail",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "scripts": {
    "start": "fiori run --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#SPLAdjudication-display\"",
    "start-local": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#SPLAdjudication-display\"",
    "start-mock": "fiori run --config ./ui5-mock.yaml --open \"test/flpSandbox.html?sap-ui-xx-viewCache=false#SPLAdjudication-display\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint webapp",
    "ts-typecheck": "echo 'TypeScript not enabled'",
    "int-test": "fiori run --config ./ui5-mock.yaml --open \"test/integration/opaTests.qunit.html\"",
    "unit-test": "fiori run --config ./ui5-mock.yaml --open \"test/unit/unitTests.qunit.html\""
  },
  "devDependencies": {
    "@sap-ux/ui5-middleware-fe-mockserver": "^2",
    "@sap/ux-specification": "latest",
    "@sap/ux-ui5-tooling": "^1.30.0",
    "@ui5/cli": "^4.0.61",
    "eslint": "^8"
  },
  "ui5": {
    "dependencies": [
      "@sap-ux/ui5-middleware-fe-mockserver"
    ]
  },
  "sapux": true
}
